# Run artifacts and logs -- never belong in source control
*.log
*.zip

# The tool's own working folders, if this repo root is ever pointed at a
# real MediaRefresh working directory instead of just holding the scripts
ISO/
LOGS/
MOUNT/
OLDWIM/
NEWWIM/
PATCHES/
TEMP/
WINPE/
WINRE/
WORKING/

# Generated at runtime, per machine -- not source
Profiles/
Settings/
INSTRUCTIONS.md.bak

# OS/editor noise
Thumbs.db
.DS_Store
*.swp

# Windows images and update packages -- far too large for GitHub (100 MB limit)
*.esd
*.wim
*.iso
*.swm
*.cab
*.msu

# Test kit scratch output -- each suite deletes and recreates its folder on
# every run (the 2 GB sparse install.esd under ptest came from profiles.ps1),
# and engine_only.ps1 is re-extracted from the main script by harness/mocks
testkit/acq/
testkit/e2e/
testkit/ptest/
testkit/rt/
testkit/tst/
testkit/engine_only.ps1
